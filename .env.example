# ==============================================================================
# Enterprise Timecard & Leave Management Portal - Environment Configuration
# ==============================================================================

# Database Configuration (Dual-mode: SQLite local default or PostgreSQL connection URI)
DATABASE_URL=sqlite:///./timecard_portal.db
DB_POOL_SIZE=10

# Cache & Message Queue
REDIS_URL=redis://localhost:6379/0

# Server & Network Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Security & Cryptographic Audit
JWT_SECRET=super-secret-sox404-portal-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SSO Configuration
SSO_MOCK_ENABLED=true
SSO_ISSUER_URL=https://sso.enterprise-portal.internal/oauth2/v1
PROJECT_ID=local-dev-project
GOOGLE_CLOUD_PROJECT=local-dev-project
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false
APP_URL=http://localhost:8000
AGENT_VERSION=1.0.0
JIRA_MCP_URL=http://localhost:8001
JIRA_TOKEN=local-dev-token
DEFAULT_PR_REVIEWERS=reviewer-1,reviewer-2
SQLITE_DB_PATH=./timecard_portal.db
