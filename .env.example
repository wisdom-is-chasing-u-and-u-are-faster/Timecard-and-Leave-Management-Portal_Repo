# Enterprise HRMS Platform Core Configuration Blueprint (12-Factor)
PORT=8080
NODE_ENV=production

# Database (GCP Cloud SQL for PostgreSQL 16)
DATABASE_URL=postgresql://hrms_user:hrms_password@localhost:5432/hrms_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=hrms_user
DB_PASSWORD=hrms_password
DB_NAME=hrms_db

# Microsoft Azure Active Directory (Entra ID)
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_SECRET=change-in-secret-manager
JWT_SECRET=super-secure-jwt-signing-secret-key-32chars

# Google Cloud Storage (Employee Document Vault)
GCS_BUCKET_NAME=persistent-genai-tf-state
GCS_PROJECT_ID=persistent-genai
GCP_REGION=us-central1
GCS_SIGNED_URL_EXPIRATION_SECONDS=900
